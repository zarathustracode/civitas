{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            id           as \"id: AuditLogId\",\n            actor_id     as \"actor_id: UserId\",\n            action,\n            entity_type,\n            entity_id,\n            metadata     as \"metadata!: JsonValue\",\n            created_at\n        from audit_log\n        where $1::uuid is null\n           or (created_at, id) < (select created_at, id from audit_log where id = $1)\n        order by created_at desc, id desc\n        limit $2\n        ",
