  "query": "\n        select distinct on (proposal_id, voter_id)\n            id          as \"id: VoteId\",\n            proposal_id as \"proposal_id: ProposalId\",\n            voter_id    as \"voter_id: UserId\",\n            choice      as \"choice: VoteChoice\",\n            cast_at\n        from votes\n        where proposal_id = any($1)\n        order by proposal_id, voter_id, cast_at desc\n        ",
